# ==============================================
# 🗄️ DATABASE (PostgreSQL) — REQUIRED
# ==============================================
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ==============================================
# 🔐 AUTH (NextAuth) — REQUIRED
# ==============================================
AUTH_SECRET="change-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# ==============================================
# 🌐 PUBLIC URL — adjust to deployment domain
# ==============================================
BASE_URL="https://your-app.example.com"
NEXTAUTH_URL="https://your-app.example.com"
NEXT_PUBLIC_APP_URL="https://your-app.example.com"
NEXT_PUBLIC_API_URL="https://your-app.example.com/api"

# ==============================================
# 🚀 APP
# ==============================================
NODE_ENV="production"
PORT="3030"
APP_NAME="WA-AKG"
TZ="Asia/Karachi"

# ==============================================
# 📚 Swagger UI (optional) — login for /swagger page
# ==============================================
NEXT_PUBLIC_SWAGGER_USERNAME="admin"
NEXT_PUBLIC_SWAGGER_PASSWORD="admin123"

# ==============================================
# 💳 PAYMENT (KlikQRIS) — OPTIONAL
# Better managed via dashboard (Settings > Payment Gateway, SUPERADMIN).
# This is only a fallback if DB is empty.
# ==============================================
KLIKQRIS_BASE_URL="https://klikqris.com/api"
KLIKQRIS_API_KEY=""
KLIKQRIS_MERCHANT_ID=""

# ==============================================
# 🔒 SECURITY (optional)
# ==============================================
# Restrict CORS API to specific origin (default "*"/all if empty).
# Set to your dashboard domain to restrict, e.g.: https://shopeelive.me
CORS_ALLOW_ORIGIN=""

# ==============================================
# ☁️ CLOUD STORAGE — OPTIONAL (Google Drive OAuth)
# Required only if using Google Drive as a cloud storage provider.
# Other providers (S3, Cloudinary, WebDAV) are configured per-user via Dashboard.
# ==============================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
